// Opportunity OS — schema do MVP
// Decisão de arquitetura central: Company e Signal são entidades GLOBAIS,
// compartilhadas entre todos os tenants. Um sinal público sobre uma empresa
// é um fato objetivo, não pertence a um cliente específico. Isso cria um
// efeito de rede de dados: quanto mais organizações usam a plataforma, mais
// rico fica o grafo de sinais para todos — sem duplicar custo de coleta.
//
// O que É por-tenant: o Opportunity Score (relevância de uma Company para
// o ICP de uma Organization específica) e o Feedback (resultado real do
// contato) — esse é o ativo proprietário que cria o moat de verdade.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANT (o cliente do SaaS: a empresa que está prospectando)
// ============================================================

// Planos comerciais — diferenciam por volume (oportunidades ativas que o
// tenant pode acompanhar simultaneamente) e por funcionalidades liberadas.
// Os limites em si (quantas oportunidades, quais features) ficam definidos
// em código (src/lib/plans.ts), não no banco — assim dá pra ajustar limite
// sem migração.
enum Plan {
  STARTER
  PROFISSIONAL
  ENTERPRISE
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  site          String?
  city          String?
  state         String?
  country       String    @default("BR")
  segment       String?
  employeeRange String?
  revenueRange  String?
  cnpj          String?
  phone         String?
  plan          Plan      @default(STARTER)
  trialEndsAt   DateTime? // null = sem limite de teste (conta já paga / uso interno)
  lastSearchAt  DateTime?

  // Assinatura via Stripe. Null = nunca assinou (ainda em trial manual, ou
  // conta cortesia/uso interno gerenciada só pelo admin). subscriptionStatus
  // guarda o status bruto do Stripe (active, trialing, past_due, canceled...)
  // — deliberadamente não é enum pra não precisar acompanhar todo valor novo
  // que o Stripe adicionar.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?

  // Saldo pré-pago genérico (não específico de busca) — trial/Starter/
  // Profissional só; Enterprise acima do teto incluso é conversa comercial,
  // não compra automática (ver plans.ts). Desenhado pra ser reaproveitado
  // por qualquer feature futura com custo de IA, não só busca — ex: quando
  // o Chat com IA (ChatConversation/ChatMessage, ainda não cobrado) sair do
  // "em breve", pode debitar do mesmo saldo em vez de precisar de um
  // mecanismo de cobrança novo. Não expira com o ciclo mensal, só é
  // decrementado quando consumido — ver a checagem de crédito em
  // executeSearch() em src/lib/opportunity-engine/search.ts.
  creditBalance Int @default(0)

  // Controle de e-mails de engajamento automático (lembretes de trial e
  // oportunidades paradas — ver src/lib/lifecycle-emails.ts, brief
  // 2026-08-14). Timestamp de quando cada um foi enviado, pra nunca
  // duplicar; os dois de trial são "uma vez só", o de oportunidades
  // paradas usa o timestamp como cooldown pra reenvio periódico.
  trialNoSearchEmailSentAt      DateTime?
  trialEndingEmailSentAt        DateTime?
  staleOpportunitiesEmailSentAt DateTime?
  // Descadastro desses e-mails de engajamento — não afeta e-mails
  // transacionais (redefinição de senha, convite de equipe, recibo).
  lifecycleEmailsOptOut         Boolean   @default(false)

  // Módulo Licitações (beta) — liberação por organização, somada à flag
  // futura por plano (plans.ts features.licitacoes). Padrão false: nenhuma
  // organização existente vê o módulo até um super-admin liberar em /admin.
  biddingEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenders            Tender[]
  bidderProfile      BidderProfile?
  bidderDocuments    BidderDocument[]
  bidderCertificates BidderCertificate[]

  users             Membership[]
  icps              ICP[]
  opportunityScores OpportunityScore[]
  feedbacks         Feedback[]
  chatConversations ChatConversation[]
  crmExports        CrmExport[]
  invites           Invite[]
  searchRuns        SearchRun[]
  searchUsageLogs   SearchUsageLog[]
  missions          Mission[]
  creditPurchases   CreditPurchase[]

  @@map("organizations")
}

// Registro de cada compra de saldo pré-pago — histórico/auditoria, e a base
// pra detectar "trial comprou saldo antes de converter" (o sinal de lead
// mais quente que existe, ver sendTrialCreditPurchaseAlert em
// src/lib/credit-alert-email.ts). "quantity" é em créditos genéricos, não
// necessariamente 1:1 com buscas pra sempre — hoje é 1:1 porque busca é a
// única coisa que consome saldo.
model CreditPurchase {
  id                      String   @id @default(cuid())
  organizationId          String
  quantity                Int
  amountBRL               Int
  stripeCheckoutSessionId String   @unique
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_purchases")
}

// Um registro por busca de oportunidades efetivamente executada (chamada à IA
// iniciada) — usado só para contar o limite de buscas/mês do plano. Uma busca
// que falha antes de retornar resultado é removida (não deve consumir o limite).
model SearchRun {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_runs")
}

// Log de uso real de IA por busca — separado do SearchRun de propósito:
// SearchRun existe só pra contar cota, e é apagado quando a busca não deve
// consumir o limite do cliente (vazia ou com erro); o custo real foi
// incorrido de qualquer jeito nesses casos, então esse log nunca é
// apagado. É o dado que embasa validar/ajustar os números de plano (brief
// 2026-08-11, item 4 — antes disso só existia estimativa calculada, não
// custo medido).
model SearchUsageLog {
  id                  String   @id @default(cuid())
  organizationId      String
  mode                String // "discovery" | "targeted"
  outcome             String // "ok" | "empty" | "parse_error" | "api_error" | "no_search"
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int
  cacheReadTokens     Int
  webSearchCount      Int
  estimatedCostUSD    Float
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_usage_logs")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String?
  phone        String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships        Membership[]
  opportunityActions OpportunityScore[]

  @@map("users")
}

// AGENCY: acesso operacional completo (ICP, oportunidades, pipeline, equipe)
// concedido pelo cliente a um parceiro externo (agência de marketing) —
// nunca tem acesso a cobrança/assinatura nem pode excluir a conta. Revogável
// a qualquer momento pelo cliente, do mesmo jeito que remover um membro.
enum Role {
  OWNER
  ADMIN
  MEMBER
  AGENCY
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  searchBlocked  Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// Convite pendente para um novo usuário entrar numa organização já existente
// (em vez de criar a própria organização, como acontece no cadastro normal).
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

// Tentativa de autenticação malsucedida (login, cadastro, reset de senha),
// usada só para rate limiting por IP contra brute-force/credential stuffing
// e abuso de envio de e-mail. `identifier` carrega o prefixo da ação, ex.
// "signin:203.0.113.7" — evita precisar de uma coluna extra. Linhas velhas
// são podadas oportunisticamente a cada escrita (ver src/lib/auth/rate-limit.ts),
// não precisa de cron.
model AuthAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("auth_attempts")
}

// Log de auditoria de eventos de segurança (login, mudança de permissão,
// ações de admin) — "Everything Must Be Logged". Nunca grava senha, token ou
// segredo em `metadata`; só contexto necessário pra reconstruir "quem fez o
// quê, quando, de onde". Sem TTL/expurgo automático de propósito — é log de
// auditoria, não cache.
model SecurityEvent {
  id             String   @id @default(cuid())
  type           String
  actorUserId    String?
  actorEmail     String?
  organizationId String?
  targetId       String?
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([type, createdAt])
  @@index([organizationId, createdAt])
  @@map("security_events")
}

// ============================================================
// ICP — critério de cliente ideal, define contra o que pontuamos
// ============================================================

// Modelo de venda do próprio contratante (não do prospect) — pontual x
// recorrente muda o que "bom encaixe" significa pra IA de busca.
enum SaleModel {
  PONTUAL
  RECORRENTE
}

model ICP {
  id                        String           @id @default(cuid())
  organizationId            String
  name                      String           @default("ICP Principal")
  segments                  String[]
  employeeMin               Int?
  employeeMax               Int?
  revenueMin                Float?
  revenueMax                Float?
  states                    String[]
  cities                    String[]
  decisionMakerTitles       String[]
  technologies              String[]
  keywords                  String[]
  productsSold              String[]
  servicesSold              String[]
  radiusKm                  Int?
  idealCustomerDescription  String?
  preferredSignalCategories SignalCategory[]
  companiesToAvoid          String[]
  // Sinal de orçamento/capacidade do prospect: quanto maior o ticket médio,
  // maior o porte que o prospect provavelmente precisa ter pra pagar.
  averageTicketBRL          Float?
  // Texto livre de propósito ("2-4 semanas", "3-6 meses") — alimenta a
  // janela de urgência do Spinos Score.
  salesCycleLength          String?
  saleModel                 SaleModel?
  isActive                  Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScores OpportunityScore[]

  @@map("icps")
}

// ============================================================
// COMPANY — entidade global compartilhada (o "prospect")
// ============================================================

model Company {
  id            String   @id @default(cuid())
  name          String
  cnpj          String?  @unique
  site          String?
  city          String?
  state         String?
  country       String   @default("BR")
  segment       String?
  employeeRange String?
  revenueRange  String?
  foundedYear   Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  signals           Signal[]
  opportunityScores OpportunityScore[]
  feedbacks         Feedback[]

  @@index([state, city])
  @@index([segment])
  @@map("companies")
}

// ============================================================
// SIGNAL — evento público detectado sobre uma Company (global)
// ============================================================

enum SignalCategory {
  HIRING
  EXPANSION
  FUNDING
  TECHNOLOGY
  MARKETING
  LEADERSHIP_CHANGE
  PROCUREMENT
  REGULATORY
  PARTNERSHIP
  AWARD
  EVENT
  ICP_MATCH
  OTHER
}

model Signal {
  id          String         @id @default(cuid())
  companyId   String
  category    SignalCategory
  sourceType  String
  sourceUrl   String?
  imageUrl    String?
  title       String
  description String?
  detectedAt  DateTime
  rawData     Json?
  confidence  Float          @default(1.0)
  createdAt   DateTime       @default(now())

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityScoreSignals OpportunityScoreSignal[]

  @@index([companyId, detectedAt])
  @@index([category])
  @@map("signals")
}

// ============================================================
// OPPORTUNITY SCORE — por tenant + company + ICP (o produto)
// ============================================================

enum OpportunityStatus {
  NEW
  REVIEWED
  CONTACTED
  DISMISSED
}

enum Urgency {
  ALTA
  MEDIA
  BAIXA
}

// Etapas do funil comercial no Kanban. Null = ainda não entrou no funil
// (está só na lista de oportunidades). O clique em "Iniciar contato"
// move para CONTATO_FEITO, a primeira coluna do quadro.
enum PipelineStage {
  CONTATO_FEITO
  VISITA_AGENDADA
  PROPOSTA_ENVIADA
  VENDIDO
  PERDIDO
}

model OpportunityScore {
  id                  String            @id @default(cuid())
  organizationId      String
  companyId           String
  icpId               String
  missionId           String?
  score               Int
  urgency             Urgency
  headline            String
  execSummary         String
  reasoning           String
  buyerArea           String?
  decisionMaker       String?
  // Nome real de uma pessoa, só quando a IA encontra via fonte pública
  // verificável (LinkedIn, "quem somos", imprensa) — decisionMaker acima
  // continua sendo só o cargo provável, mesmo quando isso aqui é null.
  decisionMakerName   String?
  suggestedApproach   String
  commercialArguments String[]
  objections          String[]
  status              OpportunityStatus @default(NEW)
  stage               PipelineStage?
  stageUpdatedAt      DateTime?
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  recommendedOffering String?
  computedAt          DateTime          @default(now())
  lastActionByUserId  String?
  lastActionAt        DateTime?

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  icp              ICP                      @relation(fields: [icpId], references: [id], onDelete: Cascade)
  mission          Mission?                 @relation(fields: [missionId], references: [id], onDelete: SetNull)
  lastActionByUser User?                    @relation(fields: [lastActionByUserId], references: [id], onDelete: SetNull)
  signalsUsed      OpportunityScoreSignal[]
  feedback         Feedback?
  crmExports       CrmExport[]

  @@unique([organizationId, companyId, icpId])
  @@index([organizationId, score])
  @@index([missionId])
  @@map("opportunity_scores")
}

// ============================================================
// MISSÃO COMERCIAL — resultado de uma execução de busca no Radar
// ============================================================

// Cada busca de oportunidades pode gerar uma nova missão, agrupando as
// oportunidades criadas/atualizadas naquela execução. A missão ativa de uma
// organização é simplesmente a mais recente (createdAt desc) — não precisa
// de um campo de status explícito pra isso.
model Mission {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScores OpportunityScore[]

  @@index([organizationId, createdAt])
  @@map("missions")
}

model OpportunityScoreSignal {
  id                 String @id @default(cuid())
  opportunityScoreId String
  signalId           String

  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)
  signal           Signal           @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([opportunityScoreId, signalId])
  @@map("opportunity_score_signals")
}

// ============================================================
// FEEDBACK — o loop proprietário que vira moat de verdade
// ============================================================

enum FeedbackOutcome {
  CONTACTED
  MEETING_BOOKED
  PROPOSAL_SENT
  CONVERTED
  NOT_INTERESTED
  WRONG_FIT
  NO_RESPONSE
}

model Feedback {
  id                 String          @id @default(cuid())
  organizationId     String
  companyId          String
  opportunityScoreId String          @unique
  outcome            FeedbackOutcome
  notes              String?
  createdAt          DateTime        @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

// ============================================================
// CHAT IA
// ============================================================

model ChatConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@map("chat_conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ============================================================
// EXPORTAÇÃO PARA CRM
// ============================================================

model CrmExport {
  id                 String   @id @default(cuid())
  organizationId     String
  opportunityScoreId String
  crmProvider        String
  exportedAt         DateTime @default(now())
  status             String   @default("success")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  @@map("crm_exports")
}

// ============================================================
// MÓDULO LICITAÇÕES (beta) — tudo por organização, com RLS.
// Tabelas-filhas carregam organizationId e uma FK composta
// (tenderId, organizationId) → tenders(id, organizationId), então o banco
// garante que um filho nunca aponta pra licitação de outra organização.
// Documentos de habilitação da empresa NUNCA vão pra IA — só o texto
// estruturado do perfil (descrição, número, validade).
// ============================================================

enum TenderStage {
  IDENTIFICADA
  EM_ANALISE
  AGUARDANDO_DECISAO
  APROVADA
  PREPARANDO_DOCUMENTACAO
  PROPOSTA_PRONTA
  PROPOSTA_ENVIADA
  EM_JULGAMENTO
  VENCIDA
  PERDIDA
  DESCARTADA
}

enum TenderDocumentKind {
  EDITAL
  TERMO_REFERENCIA
  ANEXO
  RETIFICACAO
  ESCLARECIMENTO
  COMPROVANTE
  OUTRO
}

enum TextExtractionStatus {
  PENDENTE
  OK
  SEM_TEXTO
  FALHOU
}

enum TenderAnalysisStatus {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHOU
}

// Classificação sai de uma regra em código aplicada às notas e bloqueadores,
// não da IA sozinha — não significa habilitação confirmada nem vitória.
enum TenderViabilityClass {
  RECOMENDADA
  EXIGE_AVALIACAO
  NAO_RECOMENDADA
}

enum TenderDecision {
  PARTICIPAR
  NAO_PARTICIPAR
}

enum HabilitacaoCategory {
  SOCIETARIO
  CERTIDAO
  ECONOMICO_FINANCEIRA
  ATESTADO
  DECLARACAO
  PROPOSTA_COMERCIAL
  ANEXO_ESPECIFICO
}

enum ChecklistItemStatus {
  PENDENTE
  EM_ANDAMENTO
  PRONTO
  NECESSITA_VALIDACAO
  NAO_APLICAVEL
}

model BidderProfile {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  services              String[]
  regions               String[]
  technicalCapabilities String?
  teamAvailable         String?
  // Custos de referência e margem mínima alimentam o simulador.
  referenceCosts        Json?
  minMarginPct          Float?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("bidder_profiles")
}

model BidderDocument {
  id                String              @id @default(cuid())
  organizationId    String
  category          HabilitacaoCategory
  name              String
  number            String?
  issuer            String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  version           Int                 @default(1)
  previousVersionId String?
  fileName          String?
  storagePath       String?
  sha256            String?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certificates   BidderCertificate[]
  checklistItems TenderChecklistItem[]

  @@index([organizationId, category])
  @@map("bidder_documents")
}

model BidderCertificate {
  id               String    @id @default(cuid())
  organizationId   String
  title            String
  contractingParty String?
  periodStart      DateTime?
  periodEnd        DateTime?
  quantities       String?
  documentId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     BidderDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("bidder_certificates")
}

model Tender {
  id                String      @id @default(cuid())
  organizationId    String
  agency            String
  editalNumber      String?
  processNumber     String?
  modality          String?
  object            String
  description       String?
  city              String?
  state             String?
  scope             String?
  estimatedValue    Float?
  opensAt           DateTime?
  questionsDeadline DateTime?
  sourcePortal      String?
  officialUrl       String?
  stage             TenderStage @default(IDENTIFICADA)
  stageUpdatedAt    DateTime    @default(now())
  responsibleUserId String?
  notes             String?
  // Dados de demonstração só existem em organização de demonstração.
  isFictitious      Boolean     @default(false)

  viabilityScores     Json?
  viabilityClass      TenderViabilityClass?
  viabilityComputedAt DateTime?
  decision            TenderDecision?
  decisionReason      String?
  decidedById         String?
  decidedAt           DateTime?

  protocolNumber String?
  closeReason    String?
  closeNotes     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    TenderDocument[]
  analyses     TenderAnalysis[]
  checklist    TenderChecklistItem[]
  scenarios    TenderCostScenario[]
  stageEvents  TenderStageEvent[]

  @@unique([id, organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, opensAt])
  @@map("tenders")
}

model TenderDocument {
  id               String               @id @default(cuid())
  tenderId         String
  organizationId   String
  kind             TenderDocumentKind
  fileName         String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  sha256           String
  pageCount        Int?
  extractionStatus TextExtractionStatus @default(PENDENTE)
  uploadedById     String?
  createdAt        DateTime             @default(now())

  tender Tender               @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  pages  TenderDocumentPage[]

  @@unique([id, organizationId])
  @@index([tenderId])
  @@map("tender_documents")
}

model TenderDocumentPage {
  id             String @id @default(cuid())
  documentId     String
  organizationId String
  page           Int
  text           String

  document TenderDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([documentId, page])
  @@map("tender_document_pages")
}

model TenderAnalysis {
  id               String               @id @default(cuid())
  tenderId         String
  organizationId   String
  version          Int
  status           TenderAnalysisStatus @default(PENDENTE)
  model            String?
  result           Json?
  sourceCheck      Json?
  inputTokens      Int                  @default(0)
  outputTokens     Int                  @default(0)
  estimatedCostUSD Float                @default(0)
  creditsCharged   Int                  @default(0)
  error            String?
  requestedById    String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime             @default(now())

  tender Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([tenderId, version])
  @@map("tender_analyses")
}

model TenderChecklistItem {
  id               String              @id @default(cuid())
  tenderId         String
  organizationId   String
  category         HabilitacaoCategory
  name             String
  description      String?
  source           Json?
  assigneeUserId   String?
  dueDate          DateTime?
  status           ChecklistItemStatus @default(PENDENTE)
  bidderDocumentId String?
  notes            String?
  position         Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tender         Tender          @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  bidderDocument BidderDocument? @relation(fields: [bidderDocumentId], references: [id], onDelete: SetNull)

  @@index([tenderId])
  @@map("tender_checklist_items")
}

model TenderCostScenario {
  id             String   @id @default(cuid())
  tenderId       String
  organizationId String
  name           String
  inputs         Json
  proposalValues Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tender Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([tenderId])
  @@map("tender_cost_scenarios")
}

model TenderStageEvent {
  id             String       @id @default(cuid())
  tenderId       String
  organizationId String
  fromStage      TenderStage?
  toStage        TenderStage
  userId         String?
  reason         String?
  createdAt      DateTime     @default(now())

  tender Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([tenderId, createdAt])
  @@map("tender_stage_events")
}
