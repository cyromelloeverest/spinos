// Opportunity OS — schema do MVP
// Decisão de arquitetura central: Company e Signal são entidades GLOBAIS,
// compartilhadas entre todos os tenants. Um sinal público sobre uma empresa
// é um fato objetivo, não pertence a um cliente específico. Isso cria um
// efeito de rede de dados: quanto mais organizações usam a plataforma, mais
// rico fica o grafo de sinais para todos — sem duplicar custo de coleta.
//
// O que É por-tenant: o Opportunity Score (relevância de uma Company para
// o ICP de uma Organization específica) e o Feedback (resultado real do
// contato) — esse é o ativo proprietário que cria o moat de verdade.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANT (o cliente do SaaS: a empresa que está prospectando)
// ============================================================

// Planos comerciais — diferenciam por volume (oportunidades ativas que o
// tenant pode acompanhar simultaneamente) e por funcionalidades liberadas.
// Os limites em si (quantas oportunidades, quais features) ficam definidos
// em código (src/lib/plans.ts), não no banco — assim dá pra ajustar limite
// sem migração.
enum Plan {
  STARTER
  PROFISSIONAL
  ENTERPRISE
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  site          String?
  city          String?
  state         String?
  country       String    @default("BR")
  segment       String?
  employeeRange String?
  revenueRange  String?
  cnpj          String?
  phone         String?
  plan          Plan      @default(STARTER)
  trialEndsAt   DateTime? // null = sem limite de teste (conta já paga / uso interno)
  lastSearchAt  DateTime?

  // Assinatura via Stripe. Null = nunca assinou (ainda em trial manual, ou
  // conta cortesia/uso interno gerenciada só pelo admin). subscriptionStatus
  // guarda o status bruto do Stripe (active, trialing, past_due, canceled...)
  // — deliberadamente não é enum pra não precisar acompanhar todo valor novo
  // que o Stripe adicionar.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?

  // Saldo pré-pago de buscas extras (trial/Starter/Profissional só —
  // Enterprise já tem buscas ilimitadas de verdade, nunca precisa disso).
  // Não expira com o ciclo mensal, só é decrementado quando consumido —
  // ver effectiveLimits()/consumeSearchCredit() em src/lib/trial.ts.
  searchCreditBalance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 Membership[]
  icps                  ICP[]
  opportunityScores     OpportunityScore[]
  feedbacks             Feedback[]
  chatConversations     ChatConversation[]
  crmExports            CrmExport[]
  invites               Invite[]
  searchRuns            SearchRun[]
  searchUsageLogs       SearchUsageLog[]
  missions              Mission[]
  searchCreditPurchases SearchCreditPurchase[]

  @@map("organizations")
}

// Registro de cada compra de saldo pré-pago — histórico/auditoria, e a base
// pra detectar "trial comprou saldo antes de converter" (o sinal de lead
// mais quente que existe, ver sendTrialCreditPurchaseAlert em
// src/lib/credit-alert-email.ts).
model SearchCreditPurchase {
  id                      String   @id @default(cuid())
  organizationId          String
  quantity                Int
  amountBRL               Int
  stripeCheckoutSessionId String   @unique
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_credit_purchases")
}

// Um registro por busca de oportunidades efetivamente executada (chamada à IA
// iniciada) — usado só para contar o limite de buscas/mês do plano. Uma busca
// que falha antes de retornar resultado é removida (não deve consumir o limite).
model SearchRun {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_runs")
}

// Log de uso real de IA por busca — separado do SearchRun de propósito:
// SearchRun existe só pra contar cota, e é apagado quando a busca não deve
// consumir o limite do cliente (vazia ou com erro); o custo real foi
// incorrido de qualquer jeito nesses casos, então esse log nunca é
// apagado. É o dado que embasa validar/ajustar os números de plano (brief
// 2026-08-11, item 4 — antes disso só existia estimativa calculada, não
// custo medido).
model SearchUsageLog {
  id                  String   @id @default(cuid())
  organizationId      String
  mode                String // "discovery" | "targeted"
  outcome             String // "ok" | "empty" | "parse_error" | "api_error"
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int
  cacheReadTokens     Int
  webSearchCount      Int
  estimatedCostUSD    Float
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_usage_logs")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String?
  phone        String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships        Membership[]
  opportunityActions OpportunityScore[]

  @@map("users")
}

// AGENCY: acesso operacional completo (ICP, oportunidades, pipeline, equipe)
// concedido pelo cliente a um parceiro externo (agência de marketing) —
// nunca tem acesso a cobrança/assinatura nem pode excluir a conta. Revogável
// a qualquer momento pelo cliente, do mesmo jeito que remover um membro.
enum Role {
  OWNER
  ADMIN
  MEMBER
  AGENCY
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  searchBlocked  Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// Convite pendente para um novo usuário entrar numa organização já existente
// (em vez de criar a própria organização, como acontece no cadastro normal).
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

// Tentativa de autenticação malsucedida (login, cadastro, reset de senha),
// usada só para rate limiting por IP contra brute-force/credential stuffing
// e abuso de envio de e-mail. `identifier` carrega o prefixo da ação, ex.
// "signin:203.0.113.7" — evita precisar de uma coluna extra. Linhas velhas
// são podadas oportunisticamente a cada escrita (ver src/lib/auth/rate-limit.ts),
// não precisa de cron.
model AuthAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("auth_attempts")
}

// Log de auditoria de eventos de segurança (login, mudança de permissão,
// ações de admin) — "Everything Must Be Logged". Nunca grava senha, token ou
// segredo em `metadata`; só contexto necessário pra reconstruir "quem fez o
// quê, quando, de onde". Sem TTL/expurgo automático de propósito — é log de
// auditoria, não cache.
model SecurityEvent {
  id             String   @id @default(cuid())
  type           String
  actorUserId    String?
  actorEmail     String?
  organizationId String?
  targetId       String?
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([type, createdAt])
  @@index([organizationId, createdAt])
  @@map("security_events")
}

// ============================================================
// ICP — critério de cliente ideal, define contra o que pontuamos
// ============================================================

// Modelo de venda do próprio contratante (não do prospect) — pontual x
// recorrente muda o que "bom encaixe" significa pra IA de busca.
enum SaleModel {
  PONTUAL
  RECORRENTE
}

model ICP {
  id                        String           @id @default(cuid())
  organizationId            String
  name                      String           @default("ICP Principal")
  segments                  String[]
  employeeMin               Int?
  employeeMax               Int?
  revenueMin                Float?
  revenueMax                Float?
  states                    String[]
  cities                    String[]
  decisionMakerTitles       String[]
  technologies              String[]
  keywords                  String[]
  productsSold              String[]
  servicesSold              String[]
  radiusKm                  Int?
  idealCustomerDescription  String?
  preferredSignalCategories SignalCategory[]
  companiesToAvoid          String[]
  // Sinal de orçamento/capacidade do prospect: quanto maior o ticket médio,
  // maior o porte que o prospect provavelmente precisa ter pra pagar.
  averageTicketBRL          Float?
  // Texto livre de propósito ("2-4 semanas", "3-6 meses") — alimenta a
  // janela de urgência do Spinos Score.
  salesCycleLength          String?
  saleModel                 SaleModel?
  isActive                  Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScores OpportunityScore[]

  @@map("icps")
}

// ============================================================
// COMPANY — entidade global compartilhada (o "prospect")
// ============================================================

model Company {
  id            String   @id @default(cuid())
  name          String
  cnpj          String?  @unique
  site          String?
  city          String?
  state         String?
  country       String   @default("BR")
  segment       String?
  employeeRange String?
  revenueRange  String?
  foundedYear   Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  signals           Signal[]
  opportunityScores OpportunityScore[]
  feedbacks         Feedback[]

  @@index([state, city])
  @@index([segment])
  @@map("companies")
}

// ============================================================
// SIGNAL — evento público detectado sobre uma Company (global)
// ============================================================

enum SignalCategory {
  HIRING
  EXPANSION
  FUNDING
  TECHNOLOGY
  MARKETING
  LEADERSHIP_CHANGE
  PROCUREMENT
  REGULATORY
  PARTNERSHIP
  AWARD
  EVENT
  ICP_MATCH
  OTHER
}

model Signal {
  id          String         @id @default(cuid())
  companyId   String
  category    SignalCategory
  sourceType  String
  sourceUrl   String?
  imageUrl    String?
  title       String
  description String?
  detectedAt  DateTime
  rawData     Json?
  confidence  Float          @default(1.0)
  createdAt   DateTime       @default(now())

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityScoreSignals OpportunityScoreSignal[]

  @@index([companyId, detectedAt])
  @@index([category])
  @@map("signals")
}

// ============================================================
// OPPORTUNITY SCORE — por tenant + company + ICP (o produto)
// ============================================================

enum OpportunityStatus {
  NEW
  REVIEWED
  CONTACTED
  DISMISSED
}

enum Urgency {
  ALTA
  MEDIA
  BAIXA
}

// Etapas do funil comercial no Kanban. Null = ainda não entrou no funil
// (está só na lista de oportunidades). O clique em "Iniciar contato"
// move para CONTATO_FEITO, a primeira coluna do quadro.
enum PipelineStage {
  CONTATO_FEITO
  VISITA_AGENDADA
  PROPOSTA_ENVIADA
  VENDIDO
  PERDIDO
}

model OpportunityScore {
  id                  String            @id @default(cuid())
  organizationId      String
  companyId           String
  icpId               String
  missionId           String?
  score               Int
  urgency             Urgency
  headline            String
  execSummary         String
  reasoning           String
  buyerArea           String?
  decisionMaker       String?
  // Nome real de uma pessoa, só quando a IA encontra via fonte pública
  // verificável (LinkedIn, "quem somos", imprensa) — decisionMaker acima
  // continua sendo só o cargo provável, mesmo quando isso aqui é null.
  decisionMakerName   String?
  suggestedApproach   String
  commercialArguments String[]
  objections          String[]
  status              OpportunityStatus @default(NEW)
  stage               PipelineStage?
  stageUpdatedAt      DateTime?
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  recommendedOffering String?
  computedAt          DateTime          @default(now())
  lastActionByUserId  String?
  lastActionAt        DateTime?

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  icp              ICP                      @relation(fields: [icpId], references: [id], onDelete: Cascade)
  mission          Mission?                 @relation(fields: [missionId], references: [id], onDelete: SetNull)
  lastActionByUser User?                    @relation(fields: [lastActionByUserId], references: [id], onDelete: SetNull)
  signalsUsed      OpportunityScoreSignal[]
  feedback         Feedback?
  crmExports       CrmExport[]

  @@unique([organizationId, companyId, icpId])
  @@index([organizationId, score])
  @@index([missionId])
  @@map("opportunity_scores")
}

// ============================================================
// MISSÃO COMERCIAL — resultado de uma execução de busca no Radar
// ============================================================

// Cada busca de oportunidades pode gerar uma nova missão, agrupando as
// oportunidades criadas/atualizadas naquela execução. A missão ativa de uma
// organização é simplesmente a mais recente (createdAt desc) — não precisa
// de um campo de status explícito pra isso.
model Mission {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScores OpportunityScore[]

  @@index([organizationId, createdAt])
  @@map("missions")
}

model OpportunityScoreSignal {
  id                 String @id @default(cuid())
  opportunityScoreId String
  signalId           String

  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)
  signal           Signal           @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([opportunityScoreId, signalId])
  @@map("opportunity_score_signals")
}

// ============================================================
// FEEDBACK — o loop proprietário que vira moat de verdade
// ============================================================

enum FeedbackOutcome {
  CONTACTED
  MEETING_BOOKED
  PROPOSAL_SENT
  CONVERTED
  NOT_INTERESTED
  WRONG_FIT
  NO_RESPONSE
}

model Feedback {
  id                 String          @id @default(cuid())
  organizationId     String
  companyId          String
  opportunityScoreId String          @unique
  outcome            FeedbackOutcome
  notes              String?
  createdAt          DateTime        @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

// ============================================================
// CHAT IA
// ============================================================

model ChatConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@map("chat_conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ============================================================
// EXPORTAÇÃO PARA CRM
// ============================================================

model CrmExport {
  id                 String   @id @default(cuid())
  organizationId     String
  opportunityScoreId String
  crmProvider        String
  exportedAt         DateTime @default(now())
  status             String   @default("success")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  @@map("crm_exports")
}
