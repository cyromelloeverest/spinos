// Opportunity OS — schema do MVP
// Decisão de arquitetura central: Company e Signal são entidades GLOBAIS,
// compartilhadas entre todos os tenants. Um sinal público sobre uma empresa
// é um fato objetivo, não pertence a um cliente específico. Isso cria um
// efeito de rede de dados: quanto mais organizações usam a plataforma, mais
// rico fica o grafo de sinais para todos — sem duplicar custo de coleta.
//
// O que É por-tenant: o Opportunity Score (relevância de uma Company para
// o ICP de uma Organization específica) e o Feedback (resultado real do
// contato) — esse é o ativo proprietário que cria o moat de verdade.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANT (o cliente do SaaS: a empresa que está prospectando)
// ============================================================

// Planos comerciais — diferenciam por volume (oportunidades ativas que o
// tenant pode acompanhar simultaneamente) e por funcionalidades liberadas.
// Os limites em si (quantas oportunidades, quais features) ficam definidos
// em código (src/lib/plans.ts), não no banco — assim dá pra ajustar limite
// sem migração.
enum Plan {
  STARTER
  PROFISSIONAL
  ENTERPRISE
}

model Organization {
  id                       String    @id @default(cuid())
  name                     String
  site                     String?
  city                     String?
  state                    String?
  country                  String    @default("BR")
  segment                  String?
  employeeRange            String?
  revenueRange             String?
  cnpj                     String?
  phone                    String?
  // Responsável técnico e registro profissional (CRC, OAB...): assinam o material de divulgação
  // nos nichos regulados. Opcionais; só exigidos quando o pacote do nicho pede.
  responsibleName          String?
  professionalRegistration String?
  plan                     Plan      @default(STARTER)
  trialEndsAt              DateTime? // null = sem limite de teste (conta já paga / uso interno)
  lastSearchAt             DateTime?

  // Assinatura via Stripe. Null = nunca assinou (ainda em trial manual, ou
  // conta cortesia/uso interno gerenciada só pelo admin). subscriptionStatus
  // guarda o status bruto do Stripe (active, trialing, past_due, canceled...)
  // — deliberadamente não é enum pra não precisar acompanhar todo valor novo
  // que o Stripe adicionar.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?

  // Saldo pré-pago genérico (não específico de busca) — trial/Starter/
  // Profissional só; Enterprise acima do teto incluso é conversa comercial,
  // não compra automática (ver plans.ts). Desenhado pra ser reaproveitado
  // por qualquer feature futura com custo de IA, não só busca — ex: quando
  // o Chat com IA (ChatConversation/ChatMessage, ainda não cobrado) sair do
  // "em breve", pode debitar do mesmo saldo em vez de precisar de um
  // mecanismo de cobrança novo. Não expira com o ciclo mensal, só é
  // decrementado quando consumido — ver a checagem de crédito em
  // executeSearch() em src/lib/opportunity-engine/search.ts.
  creditBalance Int @default(0)

  // Controle de e-mails de engajamento automático (lembretes de trial e
  // oportunidades paradas — ver src/lib/lifecycle-emails.ts, brief
  // 2026-08-14). Timestamp de quando cada um foi enviado, pra nunca
  // duplicar; os dois de trial são "uma vez só", o de oportunidades
  // paradas usa o timestamp como cooldown pra reenvio periódico.
  trialNoSearchEmailSentAt      DateTime?
  trialEndingEmailSentAt        DateTime?
  staleOpportunitiesEmailSentAt DateTime?
  // Descadastro desses e-mails de engajamento — não afeta e-mails
  // transacionais (redefinição de senha, convite de equipe, recibo).
  lifecycleEmailsOptOut         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             Membership[]
  icps              ICP[]
  opportunityScores OpportunityScore[]
  feedbacks         Feedback[]
  chatConversations ChatConversation[]
  crmExports        CrmExport[]
  invites           Invite[]
  searchRuns        SearchRun[]
  searchUsageLogs   SearchUsageLog[]
  missions          Mission[]
  creditPurchases   CreditPurchase[]
  pack              OrganizationPack?
  pipelines         Pipeline[]
  lossReasons       LossReason[]
  campaigns         Campaign[]
  accounts          Account[]
  contacts          Contact[]
  opportunities     Opportunity[]
  activities        Activity[]
  origins           Origin[]
  automations       Automation[]
  automationRuns    AutomationRun[]
  sites             Site[]
  siteVersions      SiteVersion[]
  siteDomains       SiteDomain[]
  siteEvents        SiteEvent[]
  contentDrafts     ContentDraft[]
  emailCampaigns    EmailCampaign[]
  emailMessages     EmailMessage[]
  emailSuppressions EmailSuppression[]

  @@map("organizations")
}

// Registro de cada compra de saldo pré-pago — histórico/auditoria, e a base
// pra detectar "trial comprou saldo antes de converter" (o sinal de lead
// mais quente que existe, ver sendTrialCreditPurchaseAlert em
// src/lib/credit-alert-email.ts). "quantity" é em créditos genéricos, não
// necessariamente 1:1 com buscas pra sempre — hoje é 1:1 porque busca é a
// única coisa que consome saldo.
model CreditPurchase {
  id                      String   @id @default(cuid())
  organizationId          String
  quantity                Int
  amountBRL               Int
  stripeCheckoutSessionId String   @unique
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_purchases")
}

// Um registro por busca de oportunidades efetivamente executada (chamada à IA
// iniciada) — usado só para contar o limite de buscas/mês do plano. Uma busca
// que falha antes de retornar resultado é removida (não deve consumir o limite).
model SearchRun {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_runs")
}

// Log de uso real de IA por busca — separado do SearchRun de propósito:
// SearchRun existe só pra contar cota, e é apagado quando a busca não deve
// consumir o limite do cliente (vazia ou com erro); o custo real foi
// incorrido de qualquer jeito nesses casos, então esse log nunca é
// apagado. É o dado que embasa validar/ajustar os números de plano (brief
// 2026-08-11, item 4 — antes disso só existia estimativa calculada, não
// custo medido).
model SearchUsageLog {
  id                  String   @id @default(cuid())
  organizationId      String
  mode                String // "discovery" | "targeted"
  outcome             String // "ok" | "empty" | "parse_error" | "api_error" | "no_search"
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int
  cacheReadTokens     Int
  webSearchCount      Int
  estimatedCostUSD    Float
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("search_usage_logs")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String?
  phone        String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships        Membership[]
  opportunityActions OpportunityScore[]

  @@map("users")
}

// AGENCY: acesso operacional completo (ICP, oportunidades, pipeline, equipe)
// concedido pelo cliente a um parceiro externo (agência de marketing) —
// nunca tem acesso a cobrança/assinatura nem pode excluir a conta. Revogável
// a qualquer momento pelo cliente, do mesmo jeito que remover um membro.
enum Role {
  OWNER
  ADMIN
  MEMBER
  AGENCY
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  searchBlocked  Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// Convite pendente para um novo usuário entrar numa organização já existente
// (em vez de criar a própria organização, como acontece no cadastro normal).
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invites")
}

// Tentativa de autenticação malsucedida (login, cadastro, reset de senha),
// usada só para rate limiting por IP contra brute-force/credential stuffing
// e abuso de envio de e-mail. `identifier` carrega o prefixo da ação, ex.
// "signin:203.0.113.7" — evita precisar de uma coluna extra. Linhas velhas
// são podadas oportunisticamente a cada escrita (ver src/lib/auth/rate-limit.ts),
// não precisa de cron.
model AuthAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("auth_attempts")
}

// Log de auditoria de eventos de segurança (login, mudança de permissão,
// ações de admin) — "Everything Must Be Logged". Nunca grava senha, token ou
// segredo em `metadata`; só contexto necessário pra reconstruir "quem fez o
// quê, quando, de onde". Sem TTL/expurgo automático de propósito — é log de
// auditoria, não cache.
model SecurityEvent {
  id             String   @id @default(cuid())
  type           String
  actorUserId    String?
  actorEmail     String?
  organizationId String?
  targetId       String?
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([type, createdAt])
  @@index([organizationId, createdAt])
  @@map("security_events")
}

// ============================================================
// ICP — critério de cliente ideal, define contra o que pontuamos
// ============================================================

// Modelo de venda do próprio contratante (não do prospect) — pontual x
// recorrente muda o que "bom encaixe" significa pra IA de busca.
enum SaleModel {
  PONTUAL
  RECORRENTE
}

model ICP {
  id                        String           @id @default(cuid())
  organizationId            String
  name                      String           @default("ICP Principal")
  segments                  String[]
  employeeMin               Int?
  employeeMax               Int?
  revenueMin                Float?
  revenueMax                Float?
  states                    String[]
  cities                    String[]
  decisionMakerTitles       String[]
  technologies              String[]
  keywords                  String[]
  productsSold              String[]
  servicesSold              String[]
  radiusKm                  Int?
  idealCustomerDescription  String?
  preferredSignalCategories SignalCategory[]
  companiesToAvoid          String[]
  // Sinal de orçamento/capacidade do prospect: quanto maior o ticket médio,
  // maior o porte que o prospect provavelmente precisa ter pra pagar.
  averageTicketBRL          Float?
  // Texto livre de propósito ("2-4 semanas", "3-6 meses") — alimenta a
  // janela de urgência do Spinos Score.
  salesCycleLength          String?
  saleModel                 SaleModel?
  isActive                  Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScores OpportunityScore[]

  @@map("icps")
}

// ============================================================
// COMPANY — entidade global compartilhada (o "prospect")
// ============================================================

model Company {
  id            String   @id @default(cuid())
  name          String
  cnpj          String?  @unique
  site          String?
  city          String?
  state         String?
  country       String   @default("BR")
  segment       String?
  employeeRange String?
  revenueRange  String?
  foundedYear   Int?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  signals           Signal[]
  opportunityScores OpportunityScore[]
  feedbacks         Feedback[]
  accounts          Account[]

  @@index([state, city])
  @@index([segment])
  @@map("companies")
}

// ============================================================
// SIGNAL — evento público detectado sobre uma Company (global)
// ============================================================

enum SignalCategory {
  HIRING
  EXPANSION
  FUNDING
  TECHNOLOGY
  MARKETING
  LEADERSHIP_CHANGE
  PROCUREMENT
  REGULATORY
  PARTNERSHIP
  AWARD
  EVENT
  ICP_MATCH
  OTHER
}

model Signal {
  id          String         @id @default(cuid())
  companyId   String
  category    SignalCategory
  sourceType  String
  sourceUrl   String?
  imageUrl    String?
  title       String
  description String?
  detectedAt  DateTime
  rawData     Json?
  confidence  Float          @default(1.0)
  createdAt   DateTime       @default(now())

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityScoreSignals OpportunityScoreSignal[]

  @@index([companyId, detectedAt])
  @@index([category])
  @@map("signals")
}

// ============================================================
// OPPORTUNITY SCORE — por tenant + company + ICP (o produto)
// ============================================================

enum OpportunityStatus {
  NEW
  REVIEWED
  CONTACTED
  DISMISSED
}

enum Urgency {
  ALTA
  MEDIA
  BAIXA
}

// Etapas do funil comercial no Kanban. Null = ainda não entrou no funil
// (está só na lista de oportunidades). O clique em "Iniciar contato"
// move para CONTATO_FEITO, a primeira coluna do quadro.
enum PipelineStage {
  CONTATO_FEITO
  VISITA_AGENDADA
  PROPOSTA_ENVIADA
  VENDIDO
  PERDIDO
}

model OpportunityScore {
  id                  String            @id @default(cuid())
  organizationId      String
  companyId           String
  icpId               String
  missionId           String?
  accountId           String?
  score               Int
  urgency             Urgency
  headline            String
  execSummary         String
  reasoning           String
  buyerArea           String?
  decisionMaker       String?
  // Nome real de uma pessoa, só quando a IA encontra via fonte pública
  // verificável (LinkedIn, "quem somos", imprensa) — decisionMaker acima
  // continua sendo só o cargo provável, mesmo quando isso aqui é null.
  decisionMakerName   String?
  suggestedApproach   String
  commercialArguments String[]
  objections          String[]
  status              OpportunityStatus @default(NEW)
  stage               PipelineStage?
  stageUpdatedAt      DateTime?
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  recommendedOffering String?
  computedAt          DateTime          @default(now())
  lastActionByUserId  String?
  lastActionAt        DateTime?

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  icp              ICP                      @relation(fields: [icpId], references: [id], onDelete: Cascade)
  mission          Mission?                 @relation(fields: [missionId], references: [id], onDelete: SetNull)
  account          Account?                 @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lastActionByUser User?                    @relation(fields: [lastActionByUserId], references: [id], onDelete: SetNull)
  signalsUsed      OpportunityScoreSignal[]
  feedback         Feedback?
  crmExports       CrmExport[]

  @@unique([organizationId, companyId, icpId])
  @@index([organizationId, score])
  @@index([missionId])
  @@map("opportunity_scores")
}

// ============================================================
// MISSÃO COMERCIAL — resultado de uma execução de busca no Radar
// ============================================================

// Cada busca de oportunidades pode gerar uma nova missão, agrupando as
// oportunidades criadas/atualizadas naquela execução. A missão ativa de uma
// organização é simplesmente a mais recente (createdAt desc) — não precisa
// de um campo de status explícito pra isso.
model Mission {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScores OpportunityScore[]

  @@index([organizationId, createdAt])
  @@map("missions")
}

model OpportunityScoreSignal {
  id                 String @id @default(cuid())
  opportunityScoreId String
  signalId           String

  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)
  signal           Signal           @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([opportunityScoreId, signalId])
  @@map("opportunity_score_signals")
}

// ============================================================
// FEEDBACK — o loop proprietário que vira moat de verdade
// ============================================================

enum FeedbackOutcome {
  CONTACTED
  MEETING_BOOKED
  PROPOSAL_SENT
  CONVERTED
  NOT_INTERESTED
  WRONG_FIT
  NO_RESPONSE
}

model Feedback {
  id                 String          @id @default(cuid())
  organizationId     String
  companyId          String
  opportunityScoreId String          @unique
  outcome            FeedbackOutcome
  notes              String?
  createdAt          DateTime        @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

// ============================================================
// CHAT IA
// ============================================================

model ChatConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@map("chat_conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ============================================================
// EXPORTAÇÃO PARA CRM
// ============================================================

model CrmExport {
  id                 String   @id @default(cuid())
  organizationId     String
  opportunityScoreId String
  crmProvider        String
  exportedAt         DateTime @default(now())
  status             String   @default("success")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityScore OpportunityScore @relation(fields: [opportunityScoreId], references: [id], onDelete: Cascade)

  @@map("crm_exports")
}

// ============================================================
// MODELO UNIFICADO (rascunho do WP1) — tudo do tenant com RLS e FK composta.
// ============================================================

enum AccountLifecycle {
  TARGET // conta-alvo, ainda sem contato
  ENGAGED // em contato / em negociação
  CUSTOMER // cliente
  LOST // perdida
  DISMISSED // descartada
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  LINKEDIN
  MEETING
  PROPOSAL
  TASK
  OTHER
}

enum ActivityStatus {
  OPEN
  DONE
  CANCELED
}

enum OriginKind {
  PROSPECTING
  LANDING_PAGE
  AD
  REFERRAL
  MANUAL
  IMPORT
  OTHER
}

enum CampaignKind {
  AD
  EMAIL
  OUTBOUND
  EVENT
  OTHER
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum LegalBasis {
  LEGITIMATE_INTEREST
  CONSENT
  CONTRACT
}

model OrganizationPack {
  id             String   @id @default(cuid())
  organizationId String   @unique
  packKey        String
  packVersion    String
  snapshot       Json
  installedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_packs")
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages        Stage[]
  opportunities Opportunity[]

  @@unique([id, organizationId])
  @@map("pipelines")
}

model Stage {
  id             String    @id @default(cuid())
  organizationId String
  pipelineId     String
  key            String
  name           String
  position       Int
  kind           StageKind @default(OPEN)
  targetPct      Float?

  pipeline      Pipeline                @relation(fields: [pipelineId, organizationId], references: [id, organizationId], onDelete: Cascade)
  opportunities Opportunity[]
  events        OpportunityStageEvent[]

  @@unique([id, organizationId])
  @@unique([pipelineId, key])
  @@map("stages")
}

model LossReason {
  id             String  @id @default(cuid())
  organizationId String
  key            String
  label          String
  requiresNote   Boolean @default(false)
  position       Int     @default(0)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([id, organizationId])
  @@unique([organizationId, key])
  @@map("loss_reasons")
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  kind           CampaignKind
  channel        String?
  name           String
  externalRef    String?
  spendBRL       Float?
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  origins       Origin[]
  opportunities Opportunity[]

  @@unique([id, organizationId])
  @@map("campaigns")
}

model Account {
  id             String           @id @default(cuid())
  organizationId String
  companyId      String?
  name           String
  cnpj           String?
  site           String?
  city           String?
  state          String?
  segment        String?
  lifecycle      AccountLifecycle @default(TARGET)
  ownerUserId    String?
  customFields   Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  origins       Origin[]
  scores        OpportunityScore[]

  @@unique([id, organizationId])
  @@unique([organizationId, companyId])
  @@unique([organizationId, cnpj])
  @@index([organizationId, lifecycle])
  @@map("accounts")
}

model Contact {
  id             String      @id @default(cuid())
  organizationId String
  accountId      String?
  name           String
  jobTitle       String?
  decisionRole   String?
  email          String?
  phone          String?
  phoneE164      String?
  linkedinUrl    String?
  isPrimary      Boolean     @default(false)
  legalBasis     LegalBasis?
  legalBasisNote String?
  optedOutAt     DateTime?
  anonymizedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account       Account?      @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)
  opportunities Opportunity[]
  activities    Activity[]
  origins       Origin[]

  @@unique([id, organizationId])
  @@index([organizationId, accountId])
  @@index([organizationId, phoneE164])
  @@map("contacts")
}

model Opportunity {
  id                 String      @id @default(cuid())
  organizationId     String
  accountId          String
  primaryContactId   String?
  pipelineId         String
  stageId            String
  title              String
  expectedValueBRL   Float?
  wonValueBRL        Float?
  status             DealStatus  @default(OPEN)
  lossReasonId       String?
  lossNote           String?
  billing            BillingType @default(ONE_TIME)
  closedAt           DateTime?
  stageChangedAt     DateTime    @default(now())
  nextActivityAt     DateTime?
  ownerUserId        String?
  campaignId         String?
  firstResponseAt    DateTime?
  lastActionByUserId String?
  lastActionAt       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account                 @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)
  primaryContact Contact?                @relation(fields: [primaryContactId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pipeline       Pipeline                @relation(fields: [pipelineId, organizationId], references: [id, organizationId])
  stage          Stage                   @relation(fields: [stageId, organizationId], references: [id, organizationId])
  lossReason     LossReason?             @relation(fields: [lossReasonId, organizationId], references: [id, organizationId])
  campaign       Campaign?               @relation(fields: [campaignId, organizationId], references: [id, organizationId])
  activities     Activity[]
  stageEvents    OpportunityStageEvent[]
  origins        Origin[]

  @@unique([id, organizationId])
  @@index([organizationId, status, stageId])
  @@map("opportunities")
}

model OpportunityStageEvent {
  id             String   @id @default(cuid())
  organizationId String
  opportunityId  String
  fromStageId    String?
  toStageId      String
  userId         String?
  createdAt      DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  toStage     Stage       @relation(fields: [toStageId, organizationId], references: [id, organizationId])

  @@index([opportunityId, createdAt])
  @@map("opportunity_stage_events")
}

model Activity {
  id              String         @id @default(cuid())
  organizationId  String
  type            ActivityType
  accountId       String?
  contactId       String?
  opportunityId   String?
  ownerUserId     String?
  dueAt           DateTime?
  doneAt          DateTime?
  status          ActivityStatus @default(OPEN)
  outcome         String?
  title           String?
  notes           String?
  automation      String?
  cadenceId       String?
  clientRequestId String?
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, clientRequestId])
  @@index([organizationId, status, dueAt])
  @@map("activities")
}

model Origin {
  id             String     @id @default(cuid())
  organizationId String
  kind           OriginKind
  channel        String?
  campaignId     String?
  landingPageId  String?
  accountId      String?
  contactId      String?
  opportunityId  String?
  isFirstTouch   Boolean    @default(false)
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  gclid          String?
  fbclid         String?
  referrerHost   String?
  occurredAt     DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId, organizationId], references: [id, organizationId])
  account      Account?     @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, accountId])
  @@index([organizationId, kind, occurredAt])
  @@map("origins")
}

// Automações do CRM: uma linha por receita por organização (ligada ou não, com os
// ajustes) e um registro de tudo que cada receita fez. O dedupeKey único garante que
// repetir um evento (reenvio, rotina de tempo rodando duas vezes) nunca duplica.
model Automation {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  enabled        Boolean  @default(false)
  config         Json?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("automations")
}

model AutomationRun {
  id             String   @id @default(cuid())
  organizationId String
  automationKey  String
  dedupeKey      String
  opportunityId  String?
  activityId     String?
  summary        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@map("automation_runs")
}

// ============================================================
// SITE E LANDING PAGES (motor do Everest Sites, dados no banco do Spinos).
// O rascunho e cada versão publicada são o documento do motor ({ schemaVersion,
// content, media, posts }), validado por src/lib/sites/content. A leitura pública
// por domínio usa o papel administrativo (só do publicado); tudo que o cliente edita
// passa por RLS.
// ============================================================

enum SiteDomainKind {
  SUBDOMAIN
  CUSTOM
}

enum SiteDomainStatus {
  PENDING
  ACTIVE
  ERROR
}

enum SiteEventType {
  VIEW
  CLICK
  FORM
  VITALS
}

model Site {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  templateKey        String?
  draft              Json
  draftRevision      Int      @default(1)
  publishedVersionId String?
  indexable          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     SiteVersion[]
  domains      SiteDomain[]
  events       SiteEvent[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("sites")
}

model SiteVersion {
  id             String   @id @default(cuid())
  siteId         String
  organizationId String
  version        Int
  content        Json
  publishedById  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([siteId, version])
  @@map("site_versions")
}

model SiteDomain {
  id             String           @id @default(cuid())
  siteId         String
  organizationId String
  hostname       String           @unique
  kind           SiteDomainKind
  isPrimary      Boolean          @default(false)
  status         SiteDomainStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([siteId])
  @@map("site_domains")
}

// Visitas e cliques sem cookie. O visitante é um hash diário de IP + navegador:
// nenhum dado pessoal é guardado. Também serve de contador de envios do formulário.
model SiteEvent {
  id             String        @id @default(cuid())
  siteId         String
  organizationId String
  type           SiteEventType
  path           String?
  target         String?
  visitorHash    String
  referrerHost   String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  device         String?
  country        String?
  // Clique de conversão: whatsapp, phone, email, cta, outbound, form, game.
  label          String?
  // Core Web Vitals (ms; cls em milésimos).
  lcp            Int?
  inp            Int?
  cls            Int?
  ttfb           Int?
  fcp            Int?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([siteId, type, visitorHash, createdAt])
  @@map("site_events")
}

// Conteúdo gerado pela IA do Spinos: sempre RASCUNHO. Nada é publicado sozinho; a pessoa lê, edita e
// aprova. Cada geração (um pedido) pode gerar várias linhas (ex.: 5 ideias) e conta como um uso.
enum ContentKind {
  IDEA
  SOCIAL_POST
  ARTICLE
  EMAIL
}

enum ContentStatus {
  DRAFT
  APPROVED
  DISCARDED
}

model ContentDraft {
  id              String        @id @default(cuid())
  organizationId  String
  generationId    String
  kind            ContentKind
  status          ContentStatus @default(DRAFT)
  channel         String?
  topic           String
  title           String
  body            String
  // Fontes citadas pela IA ([{label, url}]) e pontos que a pessoa deve conferir antes de usar.
  sources         Json          @default("[]")
  toVerify        Json          @default("[]")
  // Avisos automáticos das regras do nicho (preço, promessa, comparação...).
  warnings        Json          @default("[]")
  packKey         String?
  packVersion     String?
  usedCredit      Boolean       @default(false)
  inputTokens     Int?
  outputTokens    Int?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, generationId])
  @@map("content_drafts")
}

// E-mail enxuto: campanhas para contatos com base legal registrada (consentimento ou contrato).
// Sem e-mail frio em massa. Cada destinatário vira uma EmailMessage; descadastro, bounce e
// reclamação entram em EmailSuppression e valem para todas as campanhas da organização.
enum EmailCampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELED
}

enum EmailMessageStatus {
  QUEUED
  // Reservado por uma rodada de envio (a chamada ao provedor acontece fora de transação).
  SENDING
  SENT
  FAILED
  BOUNCED
  COMPLAINED
}

enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
  MANUAL
}

model EmailCampaign {
  id              String              @id @default(cuid())
  organizationId  String
  name            String
  subject         String
  preheader       String?
  // Texto simples (parágrafos separados por linha em branco); {{nome}} vira o primeiro nome.
  body            String
  audience        String
  status          EmailCampaignStatus @default(DRAFT)
  // Congelado no envio: o que foi mandado é o que fica registrado, mesmo que o modelo mude depois.
  htmlSnapshot    String?
  totalRecipients Int                 @default(0)
  createdByUserId String?
  startedByUserId String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     EmailMessage[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("email_campaigns")
}

model EmailMessage {
  id             String             @id @default(cuid())
  organizationId String
  campaignId     String
  // Sem chave estrangeira de propósito: a LGPD anonimiza o contato sem apagar o histórico de envio.
  contactId      String?
  email          String
  firstName      String?
  status         EmailMessageStatus @default(QUEUED)
  providerId     String?
  error          String?
  claimedAt      DateTime?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     EmailCampaign @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([organizationId, status, sentAt])
  @@index([providerId])
  @@map("email_messages")
}

model EmailSuppression {
  id             String            @id @default(cuid())
  organizationId String
  email          String
  reason         SuppressionReason
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@map("email_suppressions")
}
